# Copia este archivo a .env.local y rellena los valores. .env.local está ignorado por git.

# --- Portal (públicas: se incluyen en el JavaScript del navegador) ---
# Supabase → Project Settings → API Keys. Usa la clave publicable (sb_publishable_...),
# nunca una clave secreta (sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Para trabajar contra el Supabase local (npm run db:start):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publicable que muestra npm run db:status>

# --- Solo CLI de Supabase (npm run db:link / db:push); nunca las lee el portal ---
# Si la contraseña contiene espacios o caracteres como $, ponla entre comillas simples.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your_password
